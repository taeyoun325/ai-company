# AI COMPANY — 환경변수 예시
#
# 이 파일을 .env 로 복사해서 쓴다. .env 는 .gitignore 대상이다.
#
# 중요: API 키는 넣지 않아도 서버가 뜬다. 키가 없으면 Mock 제공자로 동작한다.
# 키는 제작을 마친 뒤 맨 마지막에 넣는다는 것이 현재 방침이다.
#
# 키를 환경변수로 넣으면 secrets_broker 가 기동 시 os.environ 에서 꺼내
# **지운다**. 이후 키는 브로커 메모리에만 있다. 헤더의 설정 화면에서
# 직접 등록해도 되고, 그쪽이 더 안전하다.

# ── 배포 자세 (지시서 §18, DAY 13) ─────────────────────────────────
# 이 저장소에는 원래 **로컬 개발도구**가 있었다. 임의 명령 실행·작업 폴더
# 열기·화면 캡처는 "내 컴퓨터에서 내가 쓴다"를 전제로 만들어졌다.
# 같은 코드가 서버에서 돌면 뜻이 완전히 달라진다 — docs/security.md 참조.
#
#   local (기본)  내 컴퓨터에서 내가 쓴다. 로컬 접근 기능 허용
#   saas          서버에서 남을 위해 돈다. 로컬 접근 기능 전부 403
#
# **서버에 올린다면 saas 다.** 기본을 local 로 둔 것은 개발 편의일 뿐이다.
DEPLOY_MODE=local

# 격리된 컨테이너 안에서 돌고 있는가. saas 에서 생성된 코드(pytest)를
# 실행하려면 이게 필요하다.
#
# 이건 자물쇠가 아니라 **운영자의 서명**이다. 우리가 확인할 방법이 없다.
# 켜기 전에 컨테이너에 네트워크 송신 제한과 자원 제한을 걸 것 —
# 그 둘 없이 켜는 것은 거짓 서명이다.
SANDBOXED=

# ── 인증 (DAY 15) ─────────────────────────────────────────────────
# DEPLOY_MODE=local  이면 로그인 없이 'local' 사용자로 동작한다.
# DEPLOY_MODE=saas   이면 로그인이 필수이고, 모든 데이터가 계정별로 갈린다.
#
# 계정은 ai_company_auth.db 에 저장된다. **색인 DB(ai_company.db)와 다른
# 파일이다** — 색인은 지워도 다시 만들 수 있지만 계정은 아니다.
# 백업은 이 파일을 포함해야 한다.
#
# 비밀번호 재설정과 이메일 인증은 아직 없다(발송 경로 미연동).
# docs/security.md §3 참조.

# ── 제공자 모드 (지시서 §7) ────────────────────────────────────────
# 키 유무에 따른 교체는 이 한 줄이 전부다. 분기는 registry.py 한 곳에만 있다.
#
#   auto (기본)  키가 있으면 실제, 없으면 Mock
#   mock         키가 있어도 Mock. 비용 없이 화면·흐름을 만들 때
#   real         Mock 으로 떨어지지 않는다. 키가 없으면 실패한다
#
# 배포에서는 real 을 쓴다. auto 로 두면 키 설정이 빠졌을 때 조용히 Mock 이
# 돌아가고, 가짜 결과물이 진짜처럼 사용자에게 간다.
PROVIDER_MODE=auto

# ── AI 제공자 키 (전부 선택) ───────────────────────────────────────
# 여기 넣는 것은 **운영자의 키**다. 요금제 중 platform 계열(스타터·프로·
# 비즈니스)이 이 키로 돌고, 그 비용이 크레딧으로 차감된다.
# 고객이 자기 키를 쓰는 요금제(byok)는 이 키를 쓰지 않는다 — app/byok.py.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
HIGGSFIELD_API_KEY=

# ── 고객 키 암호화 (BYOK · DAY 19) ─────────────────────────────────
# 고객이 등록한 API 키를 디스크에서 암호화할 때 쓰는 값. **반드시 설정한다.**
#
# 비워두면 서버가 파일(.byok_kek)에 키를 만들어 쓴다. 그러면 서버 디스크를
# 가져간 사람이 고객 키도 가져간다 — 암호화한 의미가 거의 사라진다.
# 설정했는지 여부는 설정 화면이 고객에게 그대로 보여준다.
#
# 값이 바뀌면 이미 저장된 고객 키는 **복호화되지 않는다.** 없는 키로
# 취급되고, 고객은 다시 등록해야 한다.
BYOK_SECRET=

# ── 직원별 모델 ────────────────────────────────────────────────────
# 비워두면 backend/models.json 의 기본값을 쓴다. 모델 ID 도 단가와 같은
# 이유로 코드 밖에 있다 — 시점에 따라 바뀌는 **사실**이기 때문이다.
# 키가 없는 직원은 자동으로 Mock 으로 떨어진다.
PM_MODEL=
DEV_MODEL=
QA_MODEL=
WRITER_MODEL=
DESIGNER_MODEL=

# 모델 카탈로그 파일 (기본: backend/models.json)
MODELS_FILE=

# ── 안전장치 (지시서 §18) ──────────────────────────────────────────
# 무한 에이전트 루프를 막는 하드스톱. 비우지 말 것.
MAX_AGENT_STEPS=20        # 한 실행의 에이전트 스텝 상한
MAX_RETRY=5               # API 오류 재시도 상한
MAX_ROUNDS=40             # 오케스트레이터 라운드 상한
MAX_REWORK=3              # 태스크당 반려 허용 횟수
MAX_REPLANS=3             # 전체 재기획 허용 횟수

# ── 비용 상한 (USD) ────────────────────────────────────────────────
# 호출 *전에* 최악 비용을 더해서 검사한다. 사후 감지는 상한이 아니다.
BUDGET_USD=5.0
MAX_PROJECT_COST=5.0
MAX_DAILY_COST=50.0
MAX_USER_COST=100.0

# ── 단가표 ─────────────────────────────────────────────────────────
# 코드에 하드코딩하지 않는다(지시서 §14). 기본값은 backend/pricing.json.
PRICING_FILE=

# ── 데이터 경로 (DAY 16) ──────────────────────────────────────────
# 비우면 저장소 루트를 쓴다(로컬 개발의 기존 동작).
# 컨테이너에서는 이 세 폴더만 볼륨으로 빼면 상태가 전부 보존된다.
#
# DATA_DIR 에는 계정 DB · 색인 DB · 지갑 · 저장된 키가 들어간다.
# **계정 DB 는 지우면 복구할 방법이 없다.** 백업 대상이다.
DATA_DIR=
PROJECTS_DIR=
LOGS_DIR=

# 생성된 코드의 네트워크를 끊는다 (리눅스 전용, 기본 켜짐).
# 되는지 여부는 테스트 리포트의 network_isolated 로 나간다 —
# 안 되면 안 된다고 적힌다. 막았다고 믿게 만드는 게 안 막는 것보다 나쁘다.
RUNNER_ISOLATE_NETWORK=1

# ── 데이터베이스 ───────────────────────────────────────────────────
# 개발은 SQLite, 운영은 PostgreSQL. 구조는 옮길 수 있게 쓴다(지시서 §5).
DATABASE_URL=sqlite:///./ai_company.db
# DATABASE_URL=postgresql://aicompany:aicompany@localhost:5432/aicompany

# ── 프론트엔드 ─────────────────────────────────────────────────────
# Next 가 /api 를 이 주소로 넘긴다 (frontend/next.config.ts)
BACKEND_ORIGIN=http://127.0.0.1:8000
