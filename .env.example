# AI COMPANY — 환경변수 예시
#
# 이 파일을 .env 로 복사해서 쓴다. .env 는 .gitignore 대상이다.
#
# 중요: API 키는 넣지 않아도 서버가 뜬다. 키가 없으면 Mock 제공자로 동작한다.
# 키는 제작을 마친 뒤 맨 마지막에 넣는다는 것이 현재 방침이다.
#
# 키를 환경변수로 넣으면 secrets_broker 가 기동 시 os.environ 에서 꺼내
# **지운다**. 이후 키는 브로커 메모리에만 있다. 헤더의 설정 화면에서
# 직접 등록해도 되고, 그쪽이 더 안전하다.

# ── 제공자 모드 (지시서 §7) ────────────────────────────────────────
# 키 유무에 따른 교체는 이 한 줄이 전부다. 분기는 registry.py 한 곳에만 있다.
#
#   auto (기본)  키가 있으면 실제, 없으면 Mock
#   mock         키가 있어도 Mock. 비용 없이 화면·흐름을 만들 때
#   real         Mock 으로 떨어지지 않는다. 키가 없으면 실패한다
#
# 배포에서는 real 을 쓴다. auto 로 두면 키 설정이 빠졌을 때 조용히 Mock 이
# 돌아가고, 가짜 결과물이 진짜처럼 사용자에게 간다.
PROVIDER_MODE=auto

# ── AI 제공자 키 (전부 선택) ───────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
HIGGSFIELD_API_KEY=

# ── 직원별 모델 ────────────────────────────────────────────────────
# 키가 없는 직원은 자동으로 Mock 으로 떨어진다.
PM_MODEL=claude-opus-5
DEV_MODEL=claude-opus-5
QA_MODEL=gemini-2.5-pro

# ── 안전장치 (지시서 §18) ──────────────────────────────────────────
# 무한 에이전트 루프를 막는 하드스톱. 비우지 말 것.
MAX_AGENT_STEPS=20        # 한 실행의 에이전트 스텝 상한
MAX_RETRY=5               # API 오류 재시도 상한
MAX_ROUNDS=40             # 오케스트레이터 라운드 상한
MAX_REWORK=3              # 태스크당 반려 허용 횟수
MAX_REPLANS=3             # 전체 재기획 허용 횟수

# ── 비용 상한 (USD) ────────────────────────────────────────────────
# 호출 *전에* 최악 비용을 더해서 검사한다. 사후 감지는 상한이 아니다.
BUDGET_USD=5.0
MAX_PROJECT_COST=5.0
MAX_DAILY_COST=50.0
MAX_USER_COST=100.0

# ── 단가표 ─────────────────────────────────────────────────────────
# 코드에 하드코딩하지 않는다(지시서 §14). 기본값은 backend/pricing.json.
PRICING_FILE=

# ── 데이터베이스 ───────────────────────────────────────────────────
# 개발은 SQLite, 운영은 PostgreSQL. 구조는 옮길 수 있게 쓴다(지시서 §5).
DATABASE_URL=sqlite:///./ai_company.db
# DATABASE_URL=postgresql://aicompany:aicompany@localhost:5432/aicompany

# ── 프론트엔드 ─────────────────────────────────────────────────────
# Next 가 /api 를 이 주소로 넘긴다 (frontend/next.config.ts)
BACKEND_ORIGIN=http://127.0.0.1:8000
